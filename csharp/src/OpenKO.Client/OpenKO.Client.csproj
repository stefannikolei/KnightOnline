<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenKO.Client</RootNamespace>
    <AssemblyName>OpenKO.Client</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform windowing, input and OpenGL (works on Windows, Linux and macOS). -->
    <PackageReference Include="Silk.NET.Windowing" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.21.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenKO.Common/OpenKO.Common.csproj" />
    <ProjectReference Include="../OpenKO.Numerics/OpenKO.Numerics.csproj" />
    <ProjectReference Include="../OpenKO.IO/OpenKO.IO.csproj" />
    <ProjectReference Include="../OpenKO.N3/OpenKO.N3.csproj" />
    <ProjectReference Include="../OpenKO.Net/OpenKO.Net.csproj" />
  </ItemGroup>

</Project>
