<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The clean Knight Online game exe: launches straight into the interactive login
    screen. No CLI args, no offline/screenshot/debug modes — those live in the
    separate OpenKO.Client.Dev exe. The server endpoint + data path come from
    appsettings.json (section "Client") + Client__* environment variables.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenKO.Client.App\OpenKO.Client.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
