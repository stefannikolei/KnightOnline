<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MonoGame engine layer (stage 6). Split into a pure layer (data
    preparation without a GraphicsDevice — unit-testable headless) and a thin
    device layer that hands finished arrays/states to MonoGame.
  -->

  <PropertyGroup>
    <!-- SdlIme passes an SDL_Rect* into the natively loaded SDL2. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="FontStashSharp.MonoGame" />
    <PackageReference Include="NLayer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenKO.Client.Assets\OpenKO.Client.Assets.csproj" />
  </ItemGroup>

</Project>
