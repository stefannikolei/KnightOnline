<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenKO.Core\OpenKO.Core.csproj" />
    <ProjectReference Include="..\..\OpenKO.Data\OpenKO.Data.csproj" />
    <ProjectReference Include="..\..\OpenKO.GameData\OpenKO.GameData.csproj" />
    <ProjectReference Include="..\..\OpenKO.Network\OpenKO.Network.csproj" />
    <ProjectReference Include="..\..\OpenKO.Hosting\OpenKO.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Game map data (.smd/.evt) lives in the legacy C++ server's asset store;
       copy it beside the binary so KoHost.ResolveConfigPath("MAP") finds it
       there (AiServerApp treats a missing map as fatal, unlike Ebenezer's
       best-effort stub-zone fallback). -->
  <ItemGroup>
    <Content Include="..\..\..\..\Server\bin\MAP\**\*.*" Link="MAP\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
