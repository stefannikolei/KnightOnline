<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenKO.Core\OpenKO.Core.csproj" />
    <ProjectReference Include="..\..\OpenKO.Data\OpenKO.Data.csproj" />
    <ProjectReference Include="..\..\OpenKO.GameData\OpenKO.GameData.csproj" />
    <ProjectReference Include="..\..\OpenKO.Network\OpenKO.Network.csproj" />
    <ProjectReference Include="..\..\OpenKO.Hosting\OpenKO.Hosting.csproj" />
    <ProjectReference Include="..\OpenKO.Servers.Aujard\OpenKO.Servers.Aujard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Game map/quest data lives in the legacy C++ server's asset store; copy it
       beside the binary so KoHost.ResolveConfigPath("MAP"/"QUESTS") finds it
       there. Missing files degrade gracefully here (stub zones), but real data
       is what makes zones/quests actually work instead of running as stubs. -->
  <ItemGroup>
    <Content Include="..\..\..\..\Server\bin\MAP\**\*.*" Link="MAP\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\Server\bin\QUESTS\**\*.*" Link="QUESTS\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
