<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>openko-apphost-1e0aaf3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings Microsoft.Data.SqlClient (7.0.1) transitively, used by the
         schema-readiness health check to probe KN_online directly. -->
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <!-- DbGate web UI, pre-wired to the SQL Server container. -->
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.SqlServer.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Servers + client orchestrated by the AppHost (Projects.* metadata is
         source-generated from these references). -->
    <ProjectReference Include="..\src\Servers\OpenKO.Servers.VersionManager\OpenKO.Servers.VersionManager.csproj" />
    <ProjectReference Include="..\src\Servers\OpenKO.Servers.ItemManager\OpenKO.Servers.ItemManager.csproj" />
    <ProjectReference Include="..\src\Servers\OpenKO.Servers.Aujard\OpenKO.Servers.Aujard.csproj" />
    <ProjectReference Include="..\src\Servers\OpenKO.Servers.AIServer\OpenKO.Servers.AIServer.csproj" />
    <ProjectReference Include="..\src\Servers\OpenKO.Servers.Ebenezer\OpenKO.Servers.Ebenezer.csproj" />
    <ProjectReference Include="..\src\Client\OpenKO.Client.Dev\OpenKO.Client.Dev.csproj" />
  </ItemGroup>

</Project>
